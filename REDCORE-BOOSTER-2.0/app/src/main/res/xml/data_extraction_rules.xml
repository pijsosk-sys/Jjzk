<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the restore journal describes this phone's settings only and must never be restored on
     another device (it would "restore" values that phone never had). Everything else may be backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="redcore_restore_journal.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="redcore_restore_journal.xml" />
    </device-transfer>
</data-extraction-rules>
