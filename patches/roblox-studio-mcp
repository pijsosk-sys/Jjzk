# ---- appended to roblox-studio-mcp: tools built on the plugin's RunCode ----------------------
# Every tool below is one RunCode round trip. On a phone a round trip is seconds, so the point of
# each is to replace several exploratory run_code calls with one. Nothing here needs a change to
# MCPStudioPlugin.rbxmx: the generated Luau prints a sentinel and a JSON payload, and the answer is
# read back out of the printed output, so user print() output in the same run does not confuse it.
SENTINEL = '<<<BODDY-MCP-1>>>'

def lua_string(s):
    """`s` as a Luau string literal. Escapes the three characters that end or continue a literal and
    every control byte as a decimal escape, so a script's own quotes, brackets and newlines are safe.
    A digit after a decimal escape would extend it, so escapes are always three digits."""
    out = ['"']
    for ch in str(s):
        o = ord(ch)
        if ch == '\\': out.append('\\\\')
        elif ch == '"': out.append('\\"')
        elif ch == '\n': out.append('\\n')
        elif ch == '\r': out.append('\\r')
        elif o < 32 or o == 127: out.append('\\%03d' % o)
        else: out.append(ch)
    out.append('"')
    return ''.join(out)

def lua_path(path):
    """A path as a list of child names -> Luau that resolves it from game, or nil. A list avoids the
    ambiguity of a dotted string: instance names may contain dots, spaces and quotes."""
    if path in (None, '', []): return 'game'
    if isinstance(path, str): path = [p for p in path.split('.') if p and p.lower() != 'game']
    if not isinstance(path, list) or not all(isinstance(p, str) for p in path):
        raise ValueError('path must be a list of child names, e.g. ["Workspace","Model","Part"]')
    return 'boddyResolve({%s})' % ','.join(lua_string(p) for p in path)

PRELUDE = """
local boddyHttp = game:GetService("HttpService")
local function boddyResolve(names)
 local node = game
 for _, n in ipairs(names) do
  node = node and node:FindFirstChild(n)
  if not node then return nil end
 end
 return node
end
local function boddyEmit(payload)
 print(%s .. boddyHttp:JSONEncode(payload))
end
local function boddyValue(v)
 local t = typeof(v)
 if t == "string" or t == "number" or t == "boolean" or t == "nil" then return v end
 if t == "Vector3" then return {x = v.X, y = v.Y, z = v.Z} end
 if t == "Color3" then return {r = v.R, g = v.G, b = v.B} end
 if t == "UDim2" then return {xs = v.X.Scale, xo = v.X.Offset, ys = v.Y.Scale, yo = v.Y.Offset} end
 if t == "CFrame" then return {pos = {v.Position.X, v.Position.Y, v.Position.Z}} end
 if t == "EnumItem" then return tostring(v) end
 if t == "Instance" then return {instance = v:GetFullName(), class = v.ClassName} end
 return tostring(v)
end
""" % lua_string(SENTINEL)

def code_get_tree(path=None, depth=2, limit=400):
    depth = max(0, min(int(depth if depth is not None else 2), 8))
    limit = max(1, min(int(limit if limit is not None else 400), 4000))
    return PRELUDE + """
local root = %s
if not root then boddyEmit({error = "no instance at that path"}) return end
local count, truncated = 0, false
local function walk(node, left)
 local out = {name = node.Name, class = node.ClassName}
 if left > 0 then
  local kids = {}
  for _, child in ipairs(node:GetChildren()) do
   count = count + 1
   if count > %d then truncated = true break end
   table.insert(kids, walk(child, left - 1))
  end
  if #kids > 0 then out.children = kids end
 elseif #node:GetChildren() > 0 then
  out.more = #node:GetChildren()
 end
 return out
end
local tree = walk(root, %d)
boddyEmit({tree = tree, nodes = count, truncated = truncated})
""" % (lua_path(path), limit, depth)

def code_get_properties(path, names=None):
    target = lua_path(path)
    if names:
        if not isinstance(names, list): raise ValueError('names must be a list of property names')
        wanted = '{%s}' % ','.join(lua_string(n) for n in names)
    else:
        wanted = '{"Name","ClassName","Parent","Position","Size","Anchored","Color","Material","Transparency","CFrame","Enabled","Visible","Text"}'
    return PRELUDE + """
local node = %s
if not node then boddyEmit({error = "no instance at that path"}) return end
local props, missing = {}, {}
for _, key in ipairs(%s) do
 local ok, value = pcall(function() return node[key] end)
 if ok then props[key] = boddyValue(value) else table.insert(missing, key) end
end
boddyEmit({full_name = node:GetFullName(), class = node.ClassName, properties = props, not_present = missing})
""" % (target, wanted)

def lua_literal(v):
    """A JSON-ish value as Luau. Vector3/Color3 come from {"Vector3":[x,y,z]} style tags so a caller
    can set them without writing Luau."""
    if isinstance(v, bool): return 'true' if v else 'false'
    if v is None: return 'nil'
    if isinstance(v, (int, float)): return repr(float(v)) if isinstance(v, float) else str(v)
    if isinstance(v, str): return lua_string(v)
    if isinstance(v, list): return '{%s}' % ','.join(lua_literal(x) for x in v)
    if isinstance(v, dict):
        for tag, ctor, keys in (('Vector3', 'Vector3.new', 3), ('Color3', 'Color3.fromRGB', 3),
                                ('UDim2', 'UDim2.new', 4), ('Enum', None, 0)):
            if tag in v:
                if tag == 'Enum': return 'Enum.' + str(v['Enum'])  # e.g. "Material.Plastic"
                nums = v[tag]
                if not isinstance(nums, list) or len(nums) != keys:
                    raise ValueError('%s needs %d numbers' % (tag, keys))
                return '%s(%s)' % (ctor, ','.join(lua_literal(float(n)) for n in nums))
        raise ValueError('unsupported value: %r' % (v,))
    raise ValueError('unsupported value: %r' % (v,))

def code_set_properties(path, properties):
    if not isinstance(properties, dict) or not properties:
        raise ValueError('properties must be a non-empty object')
    sets = '\n'.join(' boddySet(%s, %s)' % (lua_string(k), lua_literal(val)) for k, val in properties.items())
    return PRELUDE + """
local node = %s
if not node then boddyEmit({error = "no instance at that path"}) return end
local done, failed = {}, {}
local function boddySet(key, value)
 local ok, err = pcall(function() node[key] = value end)
 if ok then table.insert(done, key) else failed[key] = tostring(err) end
end
%s
boddyEmit({full_name = node:GetFullName(), set = done, failed = failed})
""" % (lua_path(path), sets)

SCRIPT_CLASSES = ('Script', 'LocalScript', 'ModuleScript')

def code_write_script(path, source, script_class='Script'):
    if script_class not in SCRIPT_CLASSES:
        raise ValueError('class must be one of: ' + ', '.join(SCRIPT_CLASSES))
    if not isinstance(path, list) or not path:
        raise ValueError('path must be a list of child names ending in the script name')
    parent, name = path[:-1], path[-1]
    return PRELUDE + """
local parent = %s
if not parent then boddyEmit({error = "no instance at the parent path"}) return end
local name, class = %s, %s
local node = parent:FindFirstChild(name)
local created = false
if node and node.ClassName ~= class then node:Destroy() node = nil end
if not node then node = Instance.new(class) node.Name = name node.Parent = parent created = true end
local ok, err = pcall(function() node.Source = %s end)
if not ok then boddyEmit({error = tostring(err)}) return end
boddyEmit({full_name = node:GetFullName(), class = node.ClassName, created = created, bytes = #node.Source})
""" % (lua_path(parent), lua_string(name), lua_string(script_class), lua_string(source))

def code_run_batch(commands):
    if not isinstance(commands, list) or not commands or not all(isinstance(c, str) for c in commands):
        raise ValueError('commands must be a non-empty list of Luau snippets')
    parts = []
    for i, c in enumerate(commands):
        # Each snippet is its own chunk, so a syntax error in one does not stop the others, and each
        # keeps its own printed output. loadstring is what the plugin's own command bar context allows.
        parts.append("""
local chunk%(i)d, loadErr%(i)d = loadstring(%(src)s)
if not chunk%(i)d then
 table.insert(results, {index = %(i)d, ok = false, error = "syntax: " .. tostring(loadErr%(i)d)})
else
 local ok, value = pcall(chunk%(i)d)
 table.insert(results, {index = %(i)d, ok = ok, value = boddyValue(value), error = (not ok) and tostring(value) or nil})
end""" % {'i': i, 'src': lua_string(c)})
    return PRELUDE + "\nlocal results = {}\n" + '\n'.join(parts) + "\nboddyEmit({results = results})\n"

