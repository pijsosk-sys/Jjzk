+
+/// winit's event loop for the game's window. On Android it runs on the app the
+/// activity started (`android_main`'s `AndroidApp`), which winit needs to build it.
+pub(super) fn new_event_loop()
+-> Result<winit::event_loop::EventLoop<()>, winit::error::EventLoopError> {
+    #[cfg(target_os = "android")]
+    {
+        use winit::platform::android::EventLoopBuilderExtAndroid;
+        let app = ANDROID_APP
+            .get()
+            .cloned()
+            .expect("android_main stores the AndroidApp before the game runs");
+        winit::event_loop::EventLoop::builder()
+            .with_android_app(app)
+            .build()
+    }
+    #[cfg(not(target_os = "android"))]
+    winit::event_loop::EventLoop::new()
+}
+
+/// The activity's app, set once by `android_main` before [`super::run`].
+#[cfg(target_os = "android")]
+pub(crate) static ANDROID_APP: std::sync::OnceLock<winit::platform::android::activity::AndroidApp> =
+    std::sync::OnceLock::new();
+
+/// The command line the Android entry point gives the game (an activity has no argv).
+#[cfg(target_os = "android")]
+pub(crate) static ANDROID_ARGS: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+
+/// The game's arguments: argv after the program, or the Android entry point's.
+pub(super) fn launch_args() -> Vec<String> {
+    #[cfg(target_os = "android")]
+    if let Some(args) = ANDROID_ARGS.get() {
+        return args.clone();
+    }
+    std::env::args().skip(1).collect()
+}
