 # lowest quality level and textures, and no shadows or post effects cut the work (and memory) the most.
 # Studio reads these from ClientSettings next to its program, like Roblox's player does.
-LIGHT_FLAGS={'DFIntTaskSchedulerTargetFps':24,'DFIntDebugFRMQualityLevelOverride':1,'FFlagDisablePostFx':True,
- 'FIntRenderShadowIntensity':0,'DFFlagDebugRenderForceTechnologyVoxel':True,
