<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.volkyz.apkpull"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>

    <!-- without this the installed-app list is empty on API 30+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <application
        android:label="APK Pull"
        android:icon="@android:drawable/stat_sys_download"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <provider
            android:name=".ApkProvider"
            android:authorities="com.volkyz.apkpull.files"
            android:exported="false"
            android:grantUriPermissions="true"/>
    </application>
</manifest>
