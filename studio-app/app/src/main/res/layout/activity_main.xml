<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/boddy_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Studio Launcher"
        android:textColor="@color/boddy_text"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Roblox Studio on your phone (experimental)"
        android:textColor="@color/boddy_accent_light"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/boddy_text_dim"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:indeterminateTint="@color/boddy_accent_light"
        android:max="100"
        android:progressTint="@color/boddy_accent_light"
        android:visibility="gone" />

    <Button
        android:id="@+id/action"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_primary"
        android:textAllCaps="false"
        android:textColor="@color/boddy_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- Shown once Linux is installed: the launch menu. -->
    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/studioMenu"
            style="@style/StudioButton"
            android:text="Studio menu (open a place file, diagnostics, reset)" />

        <Button
            android:id="@+id/desktop"
            style="@style/StudioButton"
            android:text="Open the desktop only" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="When something goes wrong"
        android:textColor="@color/boddy_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copyLog"
            style="@style/StudioButton"
            android:layout_width="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Copy log" />

        <Button
            android:id="@+id/shareLog"
            style="@style/StudioButton"
            android:layout_width="0dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:text="Share log" />
    </LinearLayout>

    <TextView
        android:id="@+id/logHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Copies this app's log, the last crash and Roblox Studio's launch log, so you can paste them into a chat."
        android:textColor="@color/boddy_text_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/keepAlive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/logToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="6dp"
        android:text="Show details"
        android:textColor="@color/boddy_accent_light"
        android:textSize="15sp" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/log_bg"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/boddy_text_dim"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <TextView
        android:id="@+id/reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="6dp"
        android:text="Reinstall Linux"
        android:textColor="@color/boddy_text_dim"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
</ScrollView>
