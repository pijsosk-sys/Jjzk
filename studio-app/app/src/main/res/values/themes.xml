<resources>
    <style name="Theme.Boddy" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#6C5CE7</item>
        <item name="colorAccent">#6C5CE7</item>
        <item name="android:windowBackground">@color/boddy_bg</item>
        <item name="android:statusBarColor">@color/boddy_bg</item>
        <item name="android:navigationBarColor">@color/boddy_bg</item>
    </style>
    <style name="Theme.Boddy.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="StudioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/button_card</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/boddy_text</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
