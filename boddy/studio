STUDIO_LOG_ERROR=re.compile(r'Error|error|Crash|crash|xception|ailed|Fatal|fatal|Assert|not supported|unsupported')
def studio_log(prefix,since):
 """Prints the end of the newest log Studio wrote since `since`. Returns (its error lines, whether
 Studio ended normally: it logs "End of main. Return value 0" when it was closed)."""
 logs=[p for p in prefix.glob('drive_c/users/*/AppData/Local/Roblox/logs/*.log')
  if 'Studio' in p.name and p.stat().st_mtime>=since]
 if not logs:say('Studio wrote no log of its own');return [],False
 log=max(logs,key=lambda p:p.stat().st_mtime)
 lines=[l.rstrip() for l in log.read_text(errors='replace').splitlines() if l.strip()]
