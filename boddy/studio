# Errors Studio logs on every start under Wine that have nothing to do with a crash.
STUDIO_LOG_BENIGN=re.compile(r"EnableNonClientDpiScaling|DAPClient|Secure Storage read failed|onResizeEvent|ThumbnailController|CreatorWarning|"
