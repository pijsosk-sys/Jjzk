STUDIO_NOTABLE=re.compile(r'^err: |Unimplemented|Signal (4|7|8|11):|SIGILL|SIGSEGV|Unhandled|unhandled|err:seh|wine: |NYI|Illegal|RobloxCrashHandler')
# Faults on memory Wine watches for writes ("(mmap)", "mmapped:3"): Wine handles them and Studio carries on.
BENIGN_FAULT=re.compile(r'\(mmap\)|mmapped:3')
# When Studio hits an error it cannot recover from, it starts RobloxCrashHandler and ends itself (Box64
