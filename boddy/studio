# What a Windows program crashed on, from the minidump its crash handler (Crashpad) writes.
EXCEPTIONS={0xC0000005:'access violation',0xC000001D:'illegal instruction',0xC0000409:'fast fail (Studio stopped itself)',
 0x80000003:'breakpoint',0xE06D7363:'C++ exception',0xC00000FD:'stack overflow',0xC0000374:'heap corruption',
 0xC0000094:'division by zero',0xC0000096:'privileged instruction',0x40000015:'abort'}
def read_minidump(path):
 """(exception text, module text) from a Windows minidump, or None if it has no exception."""
 d=path.read_bytes()
 if len(d)<32 or d[:4]!=b'MDMP':return None
 count,directory=struct.unpack_from('<II',d,8)
 exc=None;modules=[]
 for i in range(count):
  kind,_,rva=struct.unpack_from('<III',d,directory+12*i)
  if kind==6:  # ExceptionStream: thread id, alignment, then MINIDUMP_EXCEPTION
   code,_,_,addr,nparams=struct.unpack_from('<IIQQI',d,rva+8)
   exc=(code,addr,struct.unpack_from('<%dQ'%min(nparams,15),d,rva+40))
  elif kind==4:  # ModuleListStream: count, then 108-byte MINIDUMP_MODULEs
   for j in range(struct.unpack_from('<I',d,rva)[0]):
    base,size,_,_,name_rva=struct.unpack_from('<QIIII',d,rva+4+108*j)
    length=struct.unpack_from('<I',d,name_rva)[0]
    modules.append((base,size,d[name_rva+4:name_rva+4+length].decode('utf-16-le',errors='replace')))
 if not exc:return None
 code,addr,params=exc
 what=EXCEPTIONS.get(code,'exception 0x%08X'%code)
 if code==0xC0000005 and len(params)>=2:
  what+=' %s 0x%x'%({0:'reading',1:'writing',8:'executing'}.get(params[0],'at'),params[1])
 where=next(('%s+0x%x'%(name.replace('/','\\').split('\\')[-1],addr-base) for base,size,name in modules
  if base<=addr<base+size),'0x%x (in no loaded module)'%addr)
 return what,where
def studio_crash_dump(prefix,since,wait=30):
 """The newest minidump Studio's crash handler wrote since `since`, read; waits for the handler to finish."""
 deadline=time.time()+wait
 while True:
  dumps=[p for p in prefix.glob('drive_c/users/*/AppData/Local/Roblox/logs/crashes/**/*.dmp') if p.stat().st_mtime>=since]
  if dumps or time.time()>deadline:break
  time.sleep(2)
 if not dumps:say('Studio wrote no crash dump');return None
 dump=max(dumps,key=lambda p:p.stat().st_mtime)
 try:found=read_minidump(dump)
 except (OSError,struct.error,IndexError) as e:say('Could not read the crash dump %s: %s'%(dump.name,e));return None
 if found:say('Studio crash dump %s: %s in %s'%(dump.name,*found))
 return found
# Wine logs every exception a program raises (+seh) and where each DLL is loaded (+loaddll). Studio's
# crash handler leaves no dump under Wine, so the last serious exception before the handler starts,
# placed in the DLL it happened in, is what says why Studio crashed.
SEH_EXCEPTION=re.compile(r':seh:dispatch_exception code=([0-9a-fA-F]+) \(?(\w*)\)? ?flags=\w+ addr=(?:0x)?([0-9a-fA-F]+)')
SEH_INFO=re.compile(r':seh:dispatch_exception\s+info\[(\d+)\]=(?:0x)?([0-9a-fA-F]+)')
DLL_LOADED=re.compile(r':loaddll:\w+ Loaded L"(.+?)" at (?:0x)?([0-9a-fA-F]+)')
SEVERE=(0xC0000005,0xC000001D,0xC0000409,0xC0000374,0xC00000FD,0x80000003,0xC0000096,0xC0000094,0xC000041D,0xC0000420)
HARMLESS=(0x406D1388,0x40010006,0x4001000A,0xE06D7363,0x000006BA,0x80010108)  # thread names, debug prints, C++ throws, RPC
class ExceptionLog:
 def __init__(self):
  self.dlls=[];self.exceptions=collections.deque(maxlen=300);self.handler_at=None;self.seq=0
 def feed(self,line):
  """Takes a Wine trace line; True if it was one (and so is not printed)."""
  m=DLL_LOADED.search(line)
  if m:self.seq+=1;self.dlls.append((self.seq,int(m.group(2),16),m.group(1).replace('\\\\','\\')));return True
  m=SEH_EXCEPTION.search(line)
  if m:self.seq+=1;self.exceptions.append([self.seq,int(m.group(1),16),m.group(2),int(m.group(3),16),{}]);return True
  m=SEH_INFO.search(line)
  if m:
   if self.exceptions:self.exceptions[-1][4][int(m.group(1))]=int(m.group(2),16)
   return True
  return ':seh:' in line or ':loaddll:' in line or ':relay:' in line
 def crash_handler_started(self):
  if self.handler_at is None:self.handler_at=self.seq
 def where(self,seq,addr):
  # The DLL loaded before this exception with the highest base not above the address.
  best=max(((base,name) for s,base,name in self.dlls if s<seq and base<=addr),default=None)
  if not best or addr-best[0]>0x10000000:return '0x%x (not in a Windows DLL: Wine itself or a Linux library)'%addr
  return '%s+0x%x'%(best[1].split('\\')[-1],addr-best[0])
 def describe(self,e):
  seq,code,name,addr,info=e
  what=EXCEPTIONS.get(code) or name or 'exception 0x%08X'%code
  if code==0xC0000005 and 1 in info:
   what+=' %s 0x%x'%({0:'reading',1:'writing',8:'executing'}.get(info.get(0),'at'),info[1])
  return '%s at %s (code %08x)'%(what,self.where(seq,addr),code)
 def crash(self):
  """The exception Studio most likely crashed on, described, or None."""
  before=[e for e in self.exceptions if self.handler_at is None or e[0]<=self.handler_at]
  pick=next((e for e in reversed(before) if e[1] in SEVERE),None) or next(
   (e for e in reversed(before) if e[1] not in HARMLESS),None)
  return self.describe(pick) if pick else None
# After a crash the next start records what Studio does in detail (Box64's opcode and fault log, Wine's
# exception and DLL-load log); those cost time, so ordinary starts leave them off.
DIAGNOSE_FILE=ROOT/'diagnose-next-start'
def run_studio(args,cwd,env):
 """Runs Studio, printing what matters; with diagnostics on, with Box64's opcode log and Wine's
 exception log. Returns (exit code, notable lines)."""
 env=dict(env)
 if DIAGNOSE_FILE.exists() or os.getenv('BODDY_STUDIO_DIAGNOSE')=='1':
  say('Recording details of this run, because the last one crashed')
  if 'BOX64_LOG' in env and not os.getenv('BODDY_BOX64_LOG'):env.update(BOX64_LOG='1',BOX64_SHOWSEGV='1')
  if not os.getenv('BODDY_WINEDEBUG'):env['WINEDEBUG']=env.get('WINEDEBUG','-all,err+all')+',+seh,+loaddll'
 notable=collections.deque(maxlen=20);exceptions=ExceptionLog()
 proc=subprocess.Popen(args,cwd=cwd,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,errors='replace',bufsize=1)
 try:
  for line in proc.stdout:
   line=line.rstrip('\n')
   if exceptions.feed(line):continue
   # Box64's start-up line for the crash handler is noise like the rest, but it means Studio crashed.
   if 'Detected running wine with "RobloxCrashHandler' in line:
    notable.append('RobloxCrashHandler started: Studio crashed');exceptions.crash_handler_started()
   if STUDIO_NOISE.search(line):continue
   print(line,flush=True)
   if STUDIO_NOTABLE.search(line) and not BENIGN_FAULT.search(line):notable.append(line.replace('\x1b[31m','').replace('\x1b[0m',''))
  code=proc.wait()
 finally:
  if proc.poll() is None:proc.kill()
 crash=exceptions.crash()
 if crash:say('Last serious exception in Studio: '+crash);notable.appendleft('Exception: '+crash)
 return code,list(notable)
def offline(e):
 """Whether an error means the internet is not reachable (rather than one Wine version failing)."""
 if isinstance(e,(TlsError,OfflineError,ConnectionError,TimeoutError)):return True
 return isinstance(e,urllib.error.URLError) and not isinstance(e,urllib.error.HTTPError)
