#!/bin/bash
set -uo pipefail
mkdir -p "$HOME/.cache/roblox-studio"
LOG="$HOME/.cache/roblox-studio/launcher-$(date +%Y%m%d-%H%M%S).log"
ln -sfn "$LOG" "$HOME/.cache/roblox-studio/latest.log"
python3 - "$@" <<'BODDY_PY' 2>&1 | tee "$LOG"
#!/usr/bin/env python3
"""Boddy Linux compatibility launcher. Does not modify Roblox binaries."""
import os,sys,json,re,hashlib,zipfile,tarfile,shutil,subprocess,time,urllib.request,urllib.error,urllib.parse,ssl,fcntl
from pathlib import Path
ROOT=Path.home()/'.local/share/roblox-studio';CACHE=Path.home()/'.cache/roblox-studio'
VERSION_URL='https://clientsettingscdn.roblox.com/v2/client-version/WindowsStudio64'
CDN='https://setup.rbxcdn.com/'
DEST={'ApplicationConfig':'ApplicationConfig','BuiltInPlugins':'BuiltInPlugins','BuiltInStandalonePlugins':'BuiltInStandalonePlugins','Plugins':'Plugins','Qml':'Qml','StudioFonts':'StudioFonts','RibbonConfig':'RibbonConfig','shaders':'shaders','ssl':'ssl','WebView2RuntimeInstaller':'WebView2RuntimeInstaller','content-textures2':'content/textures','content-textures3':'PlatformContent/pc/textures','content-terrain':'PlatformContent/pc/terrain','content-platform-fonts':'PlatformContent/pc/fonts','content-platform-dictionaries':'PlatformContent/pc/shared_compression_dictionaries','content-studio_svg_textures':'content/studio_svg_textures','content-qt_translations':'content/qt_translations','content-api-docs':'content/api_docs'}
def say(s):print(s,flush=True)
class TlsError(RuntimeError):pass
_tls=None
def tls_context():
 # Verification always stays on. BODDY_CA_FILE adds a trusted root (e.g. an HTTPS-filtering proxy) without touching the system store.
 global _tls
 if _tls is None:
  _tls=ssl.create_default_context()
  extra=os.getenv('BODDY_CA_FILE')
  if extra:_tls.load_verify_locations(cafile=extra)
 return _tls
def presented_chain(host,port=443):
 # Show who signed the certificate we were given, so the user can identify the interceptor.
 if not shutil.which('openssl'):return []
 args=['openssl','s_client','-connect','%s:%d'%(host,port),'-servername',host,'-showcerts']
 proxy=urllib.request.getproxies().get('https')
 if proxy:args+=['-proxy',urllib.parse.urlsplit(proxy).netloc or proxy]
 try:out=subprocess.run(args,input=b'',capture_output=True,timeout=20).stdout.decode(errors='replace')
 except Exception:return []
 return [l.strip() for l in out.splitlines() if re.match(r'\s*\d+ s:|\s+i:',l)]
def tls_help(url,reason):
 u=urllib.parse.urlsplit(url);host=u.hostname or url
 lines=['HTTPS certificate check failed for %s: %s'%(host,getattr(reason,'verify_message',None) or reason)]
 chain=presented_chain(host,u.port or 443)
 if chain:lines+=['Certificate chain presented to this phone:']+['  '+l for l in chain]
 lines+=['',
  'Something between this phone and %s is replacing its certificate: usually a VPN, ad-blocker'%host,
  'or antivirus app with HTTPS filtering, a work/school network, or a Wi-Fi sign-in page.',
  "Boddy's Linux system does not see certificates installed in Android settings.",
  'Fix one of:',
  '  1. Turn off HTTPS filtering in that app, or switch to mobile data / another Wi-Fi, then retry.',
  '  2. If you trust that filter, export its root certificate (PEM) to Downloads and run in the Boddy terminal:',
  '       cp ~/Phone/Download/<name>.pem /usr/local/share/ca-certificates/<name>.crt && update-ca-certificates',
  '     (or set BODDY_CA_FILE=/path/to/<name>.pem for this launcher only).',
  'Certificate verification is not skipped.']
 return '\n'.join(lines)
def open_url(url):
 req=urllib.request.Request(url,headers={'User-Agent':'Boddy-Studio-Compatibility/1.0'})
 try:return urllib.request.urlopen(req,timeout=60,context=tls_context())
 except urllib.error.URLError as e:
  if isinstance(e.reason,ssl.SSLCertVerificationError):raise TlsError(tls_help(url,e.reason)) from e
  raise
def fetch(url):
 with open_url(url) as r:return r.read()
def download(url,path,size=None,md5=None,sha256=None):
 def valid(p):
  if not p.exists() or (size is not None and p.stat().st_size!=size):return False
  for alg,want in [('md5',md5),('sha256',sha256)]:
   if want:
    h=hashlib.new(alg)
    with p.open('rb') as f:
     for b in iter(lambda:f.read(1048576),b''):h.update(b)
    if h.hexdigest().lower()!=want.lower():return False
  return True
 if valid(path) and (md5 or sha256):return
 part=path.with_suffix(path.suffix+'.part');path.parent.mkdir(parents=True,exist_ok=True)
 for attempt in range(3):
  try:
   with open_url(url) as r,part.open('wb') as f:
    shutil.copyfileobj(r,f,1048576)
   if not valid(part):raise RuntimeError('Download size/checksum mismatch: '+path.name)
   part.replace(path);return
  except TlsError:raise
  except Exception:
   if attempt==2:raise
   time.sleep(1)
def manifest(data):
 lines=[s.strip() for s in data.decode().splitlines() if s.strip()]
 if not lines or lines.pop(0)!='v0' or len(lines)%4:raise ValueError('Invalid Roblox package manifest')
 result=[]
 for i in range(0,len(lines),4):
  name,digest,size,unpacked=lines[i:i+4]
  if not re.fullmatch(r'[A-Za-z0-9_.-]+\.zip',name) or not re.fullmatch(r'[a-fA-F0-9]{32}',digest):raise ValueError('Unsafe manifest package')
  size=int(size);unpacked=int(unpacked)
  if size<0 or unpacked<0:raise ValueError('Invalid package size')
  result.append((name,digest,size,unpacked))
 if not any(x[0]=='RobloxStudio.zip' for x in result):raise ValueError('Studio executable package missing')
 return result
def destination(name):
 stem=name[:-4]
 if stem in DEST:return DEST[stem]
 if stem.startswith('content-'):return 'content/'+stem[8:]
 if stem.startswith('extracontent-'):return 'ExtraContent/'+{'luapackages':'LuaPackages'}.get(stem[13:],stem[13:])
 if stem.startswith('studiocontent-'):return 'StudioContent/'+stem[14:]
 return '.'
def extract_zip(path,dest):
 with zipfile.ZipFile(path) as z:
  for item in z.infolist():
   # Roblox packages use Windows paths with a leading separator, e.g. \Lua\ for a directory.
   n=item.filename.replace('\\','/');is_dir=n.endswith('/');n=n.lstrip('/');p=Path(n)
   if n in ('','.','./'):
    if item.file_size==0:continue
    raise ValueError('Unsafe ZIP entry: '+item.filename)
   if '..' in p.parts or ':' in n or ((item.external_attr>>16)&0o170000)==0o120000:raise ValueError('Unsafe ZIP entry: '+item.filename)
   target=dest/p
   if is_dir:target.mkdir(parents=True,exist_ok=True)
   else:
    target.parent.mkdir(parents=True,exist_ok=True)
    with z.open(item) as src,target.open('wb') as out:shutil.copyfileobj(src,out)
def install_studio():
 meta=json.loads(fetch(VERSION_URL));version=meta['clientVersionUpload']
 if not re.fullmatch(r'version-[0-9a-fA-F]+',version):raise ValueError('Invalid Studio version')
 target=ROOT/'Studio';stamp=target/'.version'
 if stamp.exists() and stamp.read_text().strip()==version and (target/'RobloxStudioBeta.exe').exists():return target
 packages=manifest(fetch(CDN+version+'-rbxPkgManifest.txt'))
 required=sum(p[3] for p in packages)+max(p[2] for p in packages)+512*1024*1024
 if shutil.disk_usage(ROOT).free<required:raise RuntimeError('Insufficient free storage; need about %.1f GB'%(required/1e9))
 stage=ROOT/('stage-'+version);stage.mkdir(exist_ok=True)
 for index,(name,md5,size,_) in enumerate(packages):
  say('Studio %d/%d: %s'%(index+1,len(packages),name))
  archive=CACHE/(version+'-'+name);download(CDN+version+'-'+name,archive,size,md5)
  extract_zip(archive,stage/destination(name))
 if not (stage/'RobloxStudioBeta.exe').exists():raise RuntimeError('Studio executable absent after extraction')
 (stage/'AppSettings.xml').write_text('<Settings><ContentFolder>content</ContentFolder><BaseUrl>https://www.roblox.com</BaseUrl></Settings>')
 (stage/'.version').write_text(version)
 backup=ROOT/('Studio-backup-'+str(time.time_ns()))
 if target.exists():target.rename(backup)
 try:stage.rename(target)
 except Exception:
  if backup.exists():backup.rename(target)
  raise
 say('Studio installation verified. Previous installation retained if present.');return target
def find_wine():
 candidates=['/opt/hangover/bin/wine','/usr/bin/hangover-wine','/usr/local/bin/wine','/usr/bin/wine',shutil.which('wine')]
 return next((str(p) for p in candidates if p and os.path.isfile(p) and os.access(p,os.X_OK)),None)
def install_wine():
 w=find_wine()
 if w:return w
 if os.uname().machine not in ('aarch64','arm64'):raise RuntimeError('Boddy runtime requires ARM64 Linux')
 say('Installing Hangover for Debian 13 ARM64')
 meta=json.loads(fetch('https://api.github.com/repos/AndreRH/hangover/releases/latest'))
 assets=[a for a in meta['assets'] if re.fullmatch(r'hangover_[0-9.]+_debian13_trixie_arm64\.tar',a['name'])]
 if len(assets)!=1:raise RuntimeError('Could not identify a Debian 13 ARM64 Hangover release')
 a=assets[0];url=a['browser_download_url']
 if not url.startswith('https://github.com/AndreRH/hangover/releases/download/'):raise ValueError('Unexpected runtime URL')
 archive=CACHE/a['name'];digest=a.get('digest') or '';sha=digest[7:] if digest.startswith('sha256:') else None
 download(url,archive,a['size'],sha256=sha)
 unpack=CACHE/'hangover-packages';unpack.mkdir(exist_ok=True)
 with tarfile.open(archive) as t:
  for member in t.getmembers():
   p=Path(member.name)
   if p.is_absolute() or '..' in p.parts or not (member.isdir() or member.isfile()):raise ValueError('Unsafe runtime archive')
  t.extractall(unpack)
 debs=list(unpack.rglob('*.deb'))
 if not debs:raise RuntimeError('Runtime archive contains no Debian packages')
 subprocess.run(['apt-get','update'],check=True)
 subprocess.run(['apt-get','install','-y',*[str(p.resolve()) for p in debs]],check=True,env=dict(os.environ,DEBIAN_FRONTEND='noninteractive'))
 w=find_wine()
 if not w:raise RuntimeError('Hangover installed but Wine executable not found')
 return w
def command(args,timeout=90,env=None):
 say('Running: '+' '.join(args));r=subprocess.run(args,timeout=timeout,env=env)
 if r.returncode:raise RuntimeError('Runtime check failed with exit code '+str(r.returncode))
def diagnose():
 say('Boddy Studio compatibility report')
 say('Kernel: '+str(os.uname()));say('DISPLAY='+os.getenv('DISPLAY','<unset>'));say('Free storage: %.2f GB'%(shutil.disk_usage(ROOT).free/1e9))
 w=find_wine();say('Wine path: '+str(w))
 for url in [VERSION_URL,CDN]:
  try:open_url(url).close();say('HTTPS OK: '+url)
  except urllib.error.HTTPError:say('HTTPS OK: '+url)
  except Exception as e:say('HTTPS FAILED: '+url+'\n'+str(e))
 for args in [['getconf','PAGESIZE'],['uname','-m'],['glxinfo','-B']]:
  if shutil.which(args[0]):
   try:subprocess.run(args,timeout=20)
   except Exception as e:say(str(e))
 if w:
  try:command([w,'--version'],30)
  except Exception as e:say(str(e))
 say('Report does not include account tokens or application configuration files.')
def main():
 ROOT.mkdir(parents=True,exist_ok=True);CACHE.mkdir(parents=True,exist_ok=True)
 lock=(ROOT/'launcher.lock').open('w')
 try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
 except BlockingIOError:raise RuntimeError('A Studio launcher is already running')
 arg=sys.argv[1] if len(sys.argv)>1 else ''
 if arg=='--diagnose':diagnose();return
 if arg=='--reset':
  p=ROOT/'prefix'
  if p.exists():p.rename(ROOT/('prefix-backup-'+str(time.time_ns())))
 if arg=='--uninstall':raise RuntimeError('Automatic deletion disabled. Remove installations manually after exporting projects.')
 if not os.getenv('DISPLAY'):raise RuntimeError('Open this launcher inside the Boddy desktop so DISPLAY is set')
 wine=install_wine();prefix=ROOT/'prefix'
 env=dict(os.environ,WINEPREFIX=str(prefix),WINEARCH='win64',WINEDEBUG=os.getenv('BODDY_WINEDEBUG','-all,err+all'),LIBGL_ALWAYS_SOFTWARE='1',QT_X11_NO_MITSHM='1')
 command([wine,'--version'],30,env)
 if not (prefix/'.boddy-tested').exists():
  say('Testing Windows command execution before downloading Studio')
  command([wine,'cmd.exe','/c','echo','BODDY_WINE_STARTUP_OK'],180,env)
  (prefix/'.boddy-tested').touch()
 studio=install_studio();args=[wine,str(studio/'RobloxStudioBeta.exe')]
 if arg and not arg.startswith('--'):
  place=Path(arg).resolve()
  if not place.is_file():raise RuntimeError('Place file does not exist')
  args.append('Z:'+str(place).replace('/','\\'))
 say('Launching real Roblox Studio. A process start alone does not prove the editor works.')
 result=subprocess.run(args,cwd=studio,env=env)
 say('Studio process exited with code '+str(result.returncode));sys.exit(result.returncode)
if __name__=='__main__':
 try:main()
 except Exception as e:say('LAUNCH FAILED: '+str(e));sys.exit(1)

BODDY_PY
status=${PIPESTATUS[0]}
echo "Launcher log: $LOG"
if [ -d "$HOME/Phone/Download" ]; then
 cp "$LOG" "$HOME/Phone/Download/Boddy-Studio-launch.log" || true
 echo "Log copied to Downloads/Boddy-Studio-launch.log"
fi
exit "$status"
