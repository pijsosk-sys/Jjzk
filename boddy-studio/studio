  version=json.loads(fetch(VERSION_URL))['clientVersionUpload']
  if not isinstance(version,str) or not re.fullmatch(r'version-[0-9a-fA-F]+',version):raise ValueError('Invalid Studio version from Roblox: %r'%(version,))
 except Exception as e:
  if (target/'RobloxStudioBeta.exe').exists():
   say('Could not check for Studio updates; opening the installed version.\n'+str(e));return target
