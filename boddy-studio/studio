def extract_zip(path,dest):
 with zipfile.ZipFile(path) as z:
  for item in z.infolist():
   # Roblox packages use Windows paths with a leading separator, e.g. \Lua\ for a directory.
   n=item.filename.replace('\\','/');is_dir=n.endswith('/');n=n.lstrip('/');p=Path(n)
   if n in ('','.','./'):
    if item.file_size==0:continue
    raise ValueError('Unsafe ZIP entry: '+item.filename)
   if '..' in p.parts or ':' in n or ((item.external_attr>>16)&0o170000)==0o120000:raise ValueError('Unsafe ZIP entry: '+item.filename)
   target=dest/p
   if is_dir:target.mkdir(parents=True,exist_ok=True)
   else:
    target.parent.mkdir(parents=True,exist_ok=True)
    with z.open(item) as src,target.open('wb') as out:shutil.copyfileobj(src,out)
def prune_downloads(keep_stage=None,keep_version=None):
 # Package archives are only a download cache; old Studio copies are 1+ GB each. Keep the newest backup.
 for f in CACHE.iterdir():
  m=re.fullmatch(r'(version-[0-9a-fA-F]+)-[A-Za-z0-9_.-]+\.zip(\.part)?',f.name)
  if m and m.group(1)!=keep_version and f.is_file():f.unlink()
 for d in ROOT.glob('stage-version-*'):
  if d.is_dir() and d!=keep_stage:shutil.rmtree(d,ignore_errors=True)
 for d in sorted(ROOT.glob('Studio-backup-*'),key=lambda d:d.name)[:-1]:
  if d.is_dir():shutil.rmtree(d,ignore_errors=True)
def prune_logs(keep=10):
 for pattern in ('launcher-*.log','helper-*.log'):
  for f in sorted(CACHE.glob(pattern),key=lambda f:f.stat().st_mtime)[:-keep]:f.unlink(missing_ok=True)
def install_studio():
