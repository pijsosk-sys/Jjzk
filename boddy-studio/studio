#!/bin/bash
set -uo pipefail
mkdir -p "$HOME/.cache/roblox-studio"
# Browser hand-offs (--open-url, roblox-studio-auth: links) run while Studio is open; they keep
# their own log and leave latest.log and the launch log in Downloads pointing at the Studio launch.
helper=0
case "${1:-}" in --open-url|roblox-studio-auth:*) helper=1 ;; esac
LOG="$HOME/.cache/roblox-studio/$([ $helper = 1 ] && echo helper || echo launcher)-$(date +%Y%m%d-%H%M%S)-$$.log"
[ $helper = 1 ] || ln -sfn "$LOG" "$HOME/.cache/roblox-studio/latest.log"
python3 - "$@" <<'BODDY_PY' 2>&1 | tee "$LOG"
