def set_default_handler(mime,desktop):
 import configparser
 path=Path(os.getenv('XDG_CONFIG_HOME') or Path.home()/'.config')/'mimeapps.list'
 cfg=configparser.ConfigParser(interpolation=None,strict=False,delimiters=('=',));cfg.optionxform=str
 if path.exists():cfg.read(path)
