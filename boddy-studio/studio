def setup_browser_login(wine,env,prefix):
 # Studio's built-in login needs WebView2, which does not run here. "Login via Browser" opens the
 # sign-in page through Wine's winebrowser, and roblox.com returns to a roblox-studio-auth: link
 # that has to be handed back to the running Studio (the same approach as Vinegar).
