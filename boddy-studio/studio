  # Wine's default list (xdg-open, firefox, ...) finds no browser in Boddy, and a browser started
  # directly by Wine inherits Wine's process state, so links go through open_in_browser().
  command([wine,'reg','add','HKCU\\Software\\Wine\\WineBrowser','/v','Browsers','/t','REG_SZ','/d',BROWSERS,'/f'],600,env)
  marker.write_text(BROWSERS)
