<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textSize="18sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_overlay" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/start" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/stop" />

        <Button
            android:id="@+id/btnImportModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Import Model (.tflite)" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open Camera ESP"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/btnToolbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Minecraft Toolbox"
            android:backgroundTint="#6D4C41" />

        <SeekBar
            android:id="@+id/seekConf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="35" />

        <TextView
            android:id="@+id/tvConf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confidence: 0.35" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#888"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:text="Aim Assist — HIGH BAN RISK" />

        <Button
            android:id="@+id/btnAimPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable Accessibility" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aim Enabled" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swAutoFire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auto-Fire When On Target" />

        <TextView
            android:id="@+id/tvAimStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aim Strength: 0.35" />

        <SeekBar
            android:id="@+id/seekAim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="35" />
    </LinearLayout>
</ScrollView>
