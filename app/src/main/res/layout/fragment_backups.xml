<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/backupNow"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Back up current world"/>
        <Button android:id="@+id/snapshotAll"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Snapshot all packs"/>
    </LinearLayout>
    <ListView android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/divider"
        android:dividerHeight="1dp"/>
</LinearLayout>
