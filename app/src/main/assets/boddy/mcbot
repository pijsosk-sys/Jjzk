#!/bin/bash
# Minecraft Java bot (Mineflayer). Usage:
#   mcbot start PORT [microsoft] [HOST]   join a world (offline name BoddyBot, or a Microsoft account)
#   mcbot status | stop | quit
#   mcbot follow [PLAYER] | come [PLAYER] | goto X Y Z | mine BLOCK [COUNT] | attack | say TEXT...
# In DroidBridge: open your world to LAN; the chat shows the port. The bot needs a world that
# allows it in: a second Microsoft account ("microsoft"), or LAN with online mode off (offline).
DIR=/root/.local/share/boddy-mcbot
LOG=$DIR/bot.log
export PATH="/root/.local/bin:$PATH"

setup() {
    [ -d "$DIR/node_modules/mineflayer-collectblock" ] && return
    echo "Downloading the Minecraft bot (first time only)..."
    mkdir -p "$DIR" && cd "$DIR" || exit 1
    [ -f package.json ] || npm init -y >/dev/null
    npm install --no-audit --no-fund mineflayer mineflayer-pathfinder mineflayer-collectblock || exit 1
}

send() { # cmd args...
    local json
    json=$(python3 -c 'import json,sys; print(json.dumps({"cmd": sys.argv[1], "args": sys.argv[2:]}))' "$@")
    curl -fsS -m 30 -X POST -d "$json" http://127.0.0.1:7320/ 2>/dev/null ||
        { echo "The bot isn't running. Start it with: mcbot start PORT" >&2; return 1; }
    echo
}

case "$1" in
    start)
        [ -n "$2" ] || { sed -n '2,8p' "$0"; exit 2; }
        setup
        send status >/dev/null 2>&1 && { echo "The bot is already running (mcbot quit to stop it)."; exit 0; }
        auth=offline; [ "$3" = microsoft ] && auth=microsoft
        opts=$(python3 -c 'import json,sys; print(json.dumps({"port": sys.argv[1], "auth": sys.argv[2], "host": sys.argv[3]}))' \
            "$2" "$auth" "${4:-127.0.0.1}")
        cp /opt/boddy/mcbot.js "$DIR/mcbot.js"
        cd "$DIR" && BROWSER=/opt/boddy/open-on-phone setsid node mcbot.js "$opts" >"$LOG" 2>&1 &
        # Wait until it joins, fails, or (Microsoft accounts) shows a sign-in code.
        for _ in $(seq 30); do
            sleep 1
            grep -qiE "Joined|Kicked|Error|Disconnected|microsoft.com/link|code" "$LOG" 2>/dev/null && break
        done
        tail -n 5 "$LOG"
        grep -qi "microsoft.com/link" "$LOG" &&
            echo "Open microsoft.com/link on your phone, enter the code above with the bot's account, then check: mcbot status"
        ;;
    ""|-h|--help) sed -n '2,8p' "$0" ;;
    *) send "$@" ;;
esac
