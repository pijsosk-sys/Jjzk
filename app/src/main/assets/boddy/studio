    try:dns=open('/etc/resolv.conf').read().split()
    except OSError:dns=[]
    servers=[dns[i+1] for i,w in enumerate(dns[:-1]) if w=='nameserver']
    raise RuntimeError("No internet inside Linux: can't look up %s (%s). DNS servers: %s.\n"
     "Check Wi-Fi or mobile data. If you use a VPN, an ad blocker or Private DNS (Settings > Connections > "
     "More connection settings), try turning it off, then tap Launch again."%(host,e,', '.join(servers) or 'none'))
