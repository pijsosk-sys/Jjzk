  m=re.fullmatch(r'(version-[0-9a-fA-F]+)-[A-Za-z0-9_.-]+\.zip(\.part)?',f.name)
  if m and m.group(1)!=keep_version and f.is_file():f.unlink()
 for d in ROOT.glob('stage-version-*'):
  if d.is_dir() and d!=keep_stage:shutil.rmtree(d,ignore_errors=True)
